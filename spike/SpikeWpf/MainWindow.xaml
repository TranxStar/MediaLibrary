<Window x:Class="SpikeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MediaLibrary 阶段0验证" Height="340" Width="560"
        Background="#1E1E1E" WindowStartupLocation="Manual"
        Left="10" Top="10" Topmost="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 视频宿主 + 空域探针 ═══ -->
        <Grid Grid.Row="0" x:Name="VideoArea">

            <vlc:VideoView x:Name="MainVideo" />

            <!--
                空域探针：亮红色实心块 + 亮绿描边/文字，盖在视频正中央。
                截图分析时：
                  · 探针可见（红色/绿色像素出现） => WPF 元素能覆盖视频，无空域问题
                  · 探针不可见（只有视频画面）    => 空域问题成立，验证设计文档 §5.8 的结论
            -->
            <Border x:Name="OverlayProbe"
                    Width="220" Height="90"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFF0000" BorderBrush="#FF00FF00" BorderThickness="8">
                <TextBlock Text="PROBE"
                           Foreground="#FF00FF00" FontSize="22" FontWeight="Bold"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- ═══ 状态栏 ═══ -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#333" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="#E0E0E0" Margin="14,10"
                       FontFamily="Microsoft YaHei UI" FontSize="13"
                       Text="初始化中…" />
        </Border>
    </Grid>
</Window>
