<Window x:Class="MediaLibrary.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="640"
        MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ═══ 存储位置 ═══ -->
                <TextBlock Text="存储位置" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="素材实际存放的目录（拖入的文件会被复制到这里并转码）。更改后需要重启应用。" />

                <Border Margin="0,10,0,0" Padding="10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="RootPathText" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ChangeRootButton" Content="📂 更改位置…" Click="OnChangeRoot" />
                            <Button Content="📁 打开当前位置" Margin="8,0,0,0" Click="OnOpenCurrentRoot" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="RecentLibrariesHeader"
                           Margin="0,14,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="最近使用的库（点击切换，需重启生效）"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="RecentLibrariesList" Margin="0,6,0,0" />

                <!-- ═══ 右键菜单 ═══ -->
                <TextBlock Text="右键菜单" Margin="0,22,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="勾选哪些命令出现在素材的右键菜单里。" />

                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="MenuOpenBox" Content="打开" Click="OnSettingChanged" />
                    <CheckBox x:Name="MenuRevealBox" Content="在资源管理器中显示" Click="OnSettingChanged" />
                    <CheckBox x:Name="MenuRetranscodeBox" Content="重新转码" Click="OnSettingChanged" />
                    <CheckBox x:Name="MenuRenameBox" Content="重命名" Click="OnSettingChanged" />
                    <CheckBox x:Name="MenuDeleteBox" Content="删除到回收站" Click="OnSettingChanged" />
                    <CheckBox x:Name="MenuCopyPathBox" Content="复制文件路径" Click="OnSettingChanged" />
                </StackPanel>

                <!-- ═══ 悬浮预览 ═══ -->
                <TextBlock Text="悬浮预览" Margin="0,22,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <CheckBox x:Name="HoverEnabledBox" Content="鼠标悬停时显示预览" Margin="0,10,0,0"
                          Click="OnSettingChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="弹出延迟" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                    <Slider x:Name="HoverDelaySlider" Width="220" Margin="10,0"
                            Minimum="100" Maximum="800" TickFrequency="50"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnHoverDelayChanged" />
                    <TextBlock x:Name="HoverDelayLabel" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- ═══ 磁盘预警 ═══ -->
                <TextBlock Text="磁盘预警" Margin="0,22,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="剩余空间低于" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                    <Slider x:Name="SpaceWarningSlider" Width="180" Margin="10,0"
                            Minimum="1" Maximum="50" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnSpaceWarningChanged" />
                    <TextBlock x:Name="SpaceWarningLabel" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="GB 时告警" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 底部 ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Width="90" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
