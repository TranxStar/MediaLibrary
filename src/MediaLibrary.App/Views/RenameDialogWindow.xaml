<Window x:Class="MediaLibrary.App.Views.RenameDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量重命名"
        Width="520" Height="430"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 模板说明 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="名称模板" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <Run Text="可用占位符：" />
                <Run Text="{}{序号}" Foreground="{StaticResource AccentBrush}" /><Run Text=" 从 1 开始连续编号，" />
                <Run Text="{}{序号:D3}" Foreground="{StaticResource AccentBrush}" /><Run Text=" 三位补零编号，" />
                <Run Text="{}{原名}" Foreground="{StaticResource AccentBrush}" /><Run Text=" 原名，" />
                <Run Text="{}{原文件夹}" Foreground="{StaticResource AccentBrush}" /><Run Text=" 所在文件夹名。" />
                <LineBreak />
                <Run Text="扩展名自动保留，重名会自动加 _2、_3 后缀。" />
            </TextBlock>
        </StackPanel>

        <!-- 模板输入 -->
        <TextBox Grid.Row="1"
                 x:Name="PatternBox"
                 Margin="0,10,0,0"
                 Padding="8,6"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="14"
                 TextChanged="OnPatternChanged" />

        <!-- 预览 -->
        <Border Grid.Row="2" Margin="0,10,0,0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="预览" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />

                <ItemsControl Grid.Row="1" x:Name="PreviewList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Arrow, Mode=OneWay}" />
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="确定重命名" Width="110" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
