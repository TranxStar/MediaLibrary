<Window x:Class="MediaLibrary.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfToolkit="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:views="clr-namespace:MediaLibrary.App.Views"
        xmlns:vm="clr-namespace:MediaLibrary.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="素材库"
        Icon="pack://application:,,,/assets/app.ico"
        Height="820" Width="1280"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 文件夹树节点 -->
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <Border Margin="7,0,0,0" Padding="5,0"
                        CornerRadius="8" Background="#FF333333"
                        VerticalAlignment="Center"
                        Visibility="{Binding CountText, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding CountText}"
                               FontSize="10"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ 顶部导航栏 ═══════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Content="⟳  刷新"
                            ToolTip="重新扫描素材库，识别外部新增/删除的文件" />
                    <Button x:Name="OpenFolderButton"
                            Command="{Binding OpenCurrentFolderCommand}"
                            Content="📁 打开目录"
                            Margin="4,0,0,0"
                            ToolTip="在资源管理器中打开当前目录" />
                    <Button Command="{Binding RegenerateThumbnailsCommand}"
                            Content="🖼 重建缩略图"
                            Margin="4,0,0,0"
                            ToolTip="为当前目录重新生成缩略图" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding FolderTitle}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Border Margin="16,0,0,0" Padding="6,2"
                            Background="#FF1E1E20"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox"
                                     Width="150"
                                     Margin="4,0,0,0"
                                     Padding="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按文件名搜索当前目录" />
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="SortBox"
                              Width="86"
                              Margin="8,0,0,0"
                              FontSize="12"
                              SelectionChanged="OnSortChanged"
                              ToolTip="排序方式">
                        <ComboBoxItem Content="名称" />
                        <ComboBoxItem Content="大小" />
                        <ComboBoxItem Content="时长" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton"
                            Content="⚙ 设置"
                            ToolTip="存储位置、右键菜单、悬浮预览等设置"
                            Click="OnOpenSettings" />
                    <TextBlock Text="缩略图大小" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="10,0,8,0" />
                    <Slider Width="130"
                            Minimum="120" Maximum="320"
                            TickFrequency="20" IsSnapToTickEnabled="True"
                            Value="{Binding ThumbnailSize, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip="调整缩略图卡片大小" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ 主体 ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ── 左侧：目录树 + 空间统计 ── -->
            <Grid Grid.Column="0" Background="#FF1A1A1B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="素材库"
                           Margin="14,12,14,8"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <TreeView Grid.Row="1"
                          x:Name="FolderTreeView"
                          ItemsSource="{Binding FolderTree}"
                          SelectedItemChanged="OnFolderSelected"
                          ContextMenuOpening="OnFolderTreeContextMenuOpening"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="6,0,6,8"
                          ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItemStyle}" />
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📁 新建文件夹" Click="OnCreateFolderClick" />
                            <MenuItem Header="✏️ 重命名文件夹" Click="OnRenameFolderClick" />
                            <MenuItem Header="🗑 删除文件夹" Click="OnDeleteFolderClick" />
                            <Separator />
                            <MenuItem Header="📂 在资源管理器中打开" Click="OnRevealFolderClick" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="空间占用" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding StatsText}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="⚠ 磁盘空间不足"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding IsLowOnSpace, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding LibraryRootText}"
                                   Margin="0,6,0,0"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LibraryRootText}"
                                   Foreground="{StaticResource TextDisabledBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrushDark}" />

            <!-- ── 右侧：缩略图网格 ── -->
            <Grid Grid.Column="2">
                <views:MarqueeListBox x:Name="AssetList"
                         ItemsSource="{Binding Assets}"
                         MouseDoubleClick="OnAssetDoubleClick"
                         SelectionChanged="OnAssetSelectionChanged"
                         ContextMenuOpening="OnAssetListContextMenuOpening"
                         PreviewMouseLeftButtonDown="OnAssetListMouseDown"
                         PreviewMouseMove="OnAssetListMouseMove"
                         PreviewMouseLeftButtonUp="OnAssetListMouseUp"
                         views:AssetTile.HoverStarted="OnTileHoverStarted"
                         views:AssetTile.HoverEnded="OnTileHoverEnded"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource AssetTileItemStyle}">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <wpfToolkit:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AssetItemViewModel}">
                            <views:AssetTile
                                TileWidth="{Binding DataContext.ThumbnailSize,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开"
                                      Command="{Binding OpenAssetCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuOpen,
                                                  Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="在资源管理器中显示"
                                      Command="{Binding RevealAssetCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuReveal,
                                                  Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="重新转码"
                                      Command="{Binding RetranscodeSelectedCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuRetranscode,
                                                  Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="重命名"
                                      Command="{Binding RenameSelectedCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuRename,
                                                  Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="删除到回收站"
                                      Command="{Binding DeleteSelectedCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuDelete,
                                                  Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="复制文件路径"
                                      Command="{Binding CopyPathCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Visibility="{Binding Settings.MenuCopyPath,
                                                  Converter={StaticResource BoolToVisibility}}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </views:MarqueeListBox>

                <!-- 空状态提示 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasAssets, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="此目录暂无素材"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="把文件或文件夹拖进来，或点击「刷新」重新扫描"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextDisabledBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 忙碌遮罩 -->
                <Border Background="#99000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="正在处理…"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="14" />
                </Border>

                <!-- ═══ 框选覆盖层（拖动即框选；不参与命中测试；选框可延伸出列表边界显示）═══ -->
                <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False" Panel.ZIndex="900">
                    <Rectangle x:Name="MarqueeRect"
                               Visibility="Collapsed"
                               Fill="#2E4A9EFF"
                               Stroke="#FF4A9EFF"
                               StrokeThickness="1"
                               RadiusX="2" RadiusY="2" />
                </Canvas>

                <!-- ═══ 选择工具条（选中素材后出现）═══ -->
                <Border Panel.ZIndex="950"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="14,10,14,0"
                        Padding="10,7"
                        CornerRadius="6"
                        Background="#F02A2A2C"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="已选 " /><Run Text="{Binding SelectionCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" /><Run Text=" 项" />
                        </TextBlock>

                        <Button Content="全选" Style="{StaticResource CompactButtonStyle}" Click="OnSelectAllClick" ToolTip="Ctrl+A" />
                        <Button Content="反选" Style="{StaticResource CompactButtonStyle}" Click="OnInvertSelectionClick" />
                        <Button Content="取消选择" Style="{StaticResource CompactButtonStyle}" Click="OnClearSelectionClick" ToolTip="Esc" />

                        <Border Width="1" Background="{StaticResource BorderBrushDark}" Margin="8,2" />

                        <Button Content="重命名" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding RenameSelectedCommand}"
                                ToolTip="按模板 + 连续序号批量重命名" />
                        <Button Content="重新转码" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding RetranscodeSelectedCommand}"
                                ToolTip="把选中素材重新排队处理（覆盖库内文件）" />
                        <Button Content="删除到回收站" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding DeleteSelectedCommand}"
                                ToolTip="文件进回收站可还原，库内记录删除" />
                    </StackPanel>
                </Border>

                <!-- ═══ 任务队列面板（阶段 4）═══ -->
                <Border Panel.ZIndex="960"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,14,12"
                        Width="480" MaxHeight="360"
                        CornerRadius="8"
                        Background="#F5262528"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="1"
                        DataContext="{Binding JobQueue, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 头部：标题 + 汇总 + 全局按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="任务队列" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SummaryText}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏸ 全部暂停" Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding PauseAllCommand}"
                                        Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Button Content="▶ 继续" Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ResumeAllCommand}"
                                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="✕ 取消全部" Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding CancelAllCommand}" />
                                <Button Content="🗑 清除已结束" Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ClearFinishedCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 任务列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5" Padding="8,6"
                                                Background="#FF1E1E20" CornerRadius="4">
                                            <Border.ToolTip>
                                                <TextBlock Text="{Binding ErrorMessage}" MaxWidth="380"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            </Border.ToolTip>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="{Binding TypeText}" />

                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding AssetName}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <ProgressBar Width="120" Height="6"
                                                                     Minimum="0" Maximum="1"
                                                                     Value="{Binding Progress, Mode=OneWay}" />
                                                        <TextBlock Margin="8,0,0,0" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="重试" Style="{StaticResource CompactButtonStyle}"
                                                            Command="{Binding DataContext.RetryJobCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="取消" Style="{StaticResource CompactButtonStyle}"
                                                            Command="{Binding DataContext.CancelJobCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 底部：总进度 -->
                        <ProgressBar Grid.Row="2" Height="4" Margin="0,8,0,2"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding OverallProgress, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- 悬浮预览的覆盖层：预览面板挂在这里（主窗口内的浮层，非独立窗口） -->
                <Canvas x:Name="HoverOverlay" Panel.ZIndex="1000" />
            </Grid>
        </Grid>

        <!-- ═══════════════ 状态栏 ═══════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Grid.Column="1"
                           Margin="16,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           Text="缩略图生成中…"
                           Visibility="{Binding ShowEnrichmentHint, Converter={StaticResource BoolToVisibility}}" />

                <!-- 任务队列开关（阶段 4） -->
                <Button Grid.Column="2"
                        Margin="14,0,0,0"
                        Padding="8,2"
                        Style="{StaticResource CompactButtonStyle}"
                        Content="{Binding JobQueue.BadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding JobQueue.TogglePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="打开/收起任务队列面板" />

                <TextBlock Grid.Column="3"
                           Margin="16,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}"
                           Text="{Binding EncoderText}" />
            </Grid>
        </Border>

        <!-- ═══════════════ 任务条（有任务时才出现；点击打开队列面板）═══════════════ -->
        <Border Grid.Row="2"
                VerticalAlignment="Top"
                Margin="0,-34,0,0"
                Height="34"
                Background="#FF2A2A2C"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,1,0,0"
                Cursor="Hand"
                MouseLeftButtonUp="OnJobStripClick"
                Visibility="{Binding IsJobRunning, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="⏳" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding JobStatusText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="11" />

                <TextBlock Grid.Column="2"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}">
                    <Run Text="{Binding JobProgressFraction, Mode=OneWay, StringFormat={}{0:P0}}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════ 拖放提示遮罩 ═══════════════ -->
        <Grid Grid.RowSpan="3"
              Background="#CC0A2A4A"
              IsHitTestVisible="False"
              Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⤓"
                           FontSize="54"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="松手即导入"
                           FontSize="22"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="视频转 H.265 · 照片转 PNG · 音频原样复制 · 统一命名"
                           FontSize="12"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="素材会实际复制进素材库，原始文件不会被修改"
                           FontSize="12"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
