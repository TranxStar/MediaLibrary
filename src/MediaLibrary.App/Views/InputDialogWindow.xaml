<Window x:Class="MediaLibrary.App.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="420" Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <TextBox x:Name="InputBox"
                 Grid.Row="1" Margin="0,12,0,0"
                 Padding="8,6" FontSize="14"
                 FontFamily="{StaticResource MonoFont}"
                 Loaded="OnInputLoaded" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2" Margin="0,6,0,0" FontSize="11"
                   Foreground="{StaticResource DangerBrush}"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="确定" Width="90" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
