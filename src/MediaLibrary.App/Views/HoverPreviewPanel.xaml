<UserControl x:Class="MediaLibrary.App.Views.HoverPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="280"
             x:Name="Root">

    <!--
        ★ 命中测试结构（踩过坑后定稿）：
        WPF 的 IsHitTestVisible=False 会【切断整个子树】的命中测试。
        · 根 Grid 无背景 → 本身不参与命中
        · 画面区带背景 → 参与命中，拦住下面的卡片（不穿透）
        · 控制条是画面区的【兄弟节点】→ 可点击可拖动

        ★ 为什么画面区【不能】穿透（用户实测教训）：
        穿透时鼠标一移到面板上，被面板盖住的卡片照样收到 MouseEnter →
        预览立刻切到"鼠标下面的文件"并跳走，新位置下面又压着别的卡片 →
        来回切换的死循环，控制条永远点不到。
        面板必须像真正的悬浮窗一样挡住下面的卡片。
    -->
    <Grid x:Name="RootGrid" Background="{x:Null}"
          Effect="{DynamicResource PanelShadow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- ═══ 画面区（拦截鼠标：挡住下面的卡片，控制条才能被点到）═══ -->
        <Border Grid.Row="0"
                Background="#F01E1E1E"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0">
            <Grid Background="Black" ClipToBounds="True">

                <!-- 视频帧（WriteableBitmap） -->
                <Image x:Name="VideoImage" Stretch="Fill" SnapsToDevicePixels="True" />

                <!-- 封面：音频波形图 / 照片缩略图 -->
                <Image x:Name="Poster" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- 音频模式提示 -->
                <Border x:Name="AudioBadge"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10" Padding="7,3"
                        CornerRadius="3" Background="#99000000"
                        Visibility="Collapsed">
                    <TextBlock Text="♪ 音频预览" FontSize="11" Foreground="#FFE0E0E0" />
                </Border>

                <!-- 固定状态提示 -->
                <Border x:Name="PinBadge"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="10" Padding="8,3"
                        CornerRadius="3" Background="#E64A9EFF"
                        Visibility="Collapsed"
                        ToolTip="按空格取消固定，或按 Esc 关闭">
                    <TextBlock Text="📌 已固定 · 空格取消"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF101010" />
                </Border>

                <!-- 文件名 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="10,0,10,8" Padding="8,3"
                        CornerRadius="3" Background="#99000000">
                    <TextBlock x:Name="NameText" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="380"
                               Foreground="#FFE0E0E0" />
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             控制条：画面区的兄弟节点，可交互。
             手工刮擦条：整行可点击（点击即跳转）、按住拖动、松开落定。
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#FF252526"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,8,8"
                x:Name="ControlBar"
                Cursor="Hand"
                MouseLeftButtonDown="OnScrubDown"
                MouseMove="OnScrubMove"
                MouseLeftButtonUp="OnScrubUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="40" VerticalAlignment="Center" x:Name="TrackArea" Margin="10,0,0,0">
                    <Border Height="4" CornerRadius="2"
                            Background="#FF3A3A3A" VerticalAlignment="Center" />
                    <Border x:Name="FillBar" Height="4" CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="0" />
                    <Ellipse x:Name="ThumbDot" Width="14" Height="14"
                             Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Margin="-7,0,0,0" />
                </Grid>

                <TextBlock x:Name="TimeText"
                           Grid.Column="1"
                           Margin="10,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="00:00 / 00:00" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
