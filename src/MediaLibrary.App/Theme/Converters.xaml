<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MediaLibrary.App.Converters">

    <conv:TileWidthToHeightConverter x:Key="TileHeight" />
    <conv:NullToCollapsedConverter     x:Key="NullToCollapsed" />
    <conv:NullToVisibleConverter       x:Key="NullToVisible" />
    <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
    <conv:InverseBooleanConverter      x:Key="InverseBool" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:MultiplyConverter            x:Key="Multiply" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

</ResourceDictionary>
