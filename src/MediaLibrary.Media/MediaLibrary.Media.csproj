<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- ★ 阶段0 发现：VideoLAN.LibVLC.Windows 在 Platform=AnyCPU 时会同时投递
         x64 + x86 + arm64 三套原生库（实测 299 MB）。显式关闭多余架构，
         实测输出从 325 MB 降到 132 MB。绝不要删掉这三行。 -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="FFMpegCore" Version="5.5.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaLibrary.Core\MediaLibrary.Core.csproj" />
  </ItemGroup>

  <!-- 让测试项目能校验 ffmpeg 参数构建与进度解析这类内部实现 -->
  <ItemGroup>
    <InternalsVisibleTo Include="MediaLibrary.Core.Tests" />
  </ItemGroup>

</Project>
